  },
  "action_classes": {
    "summarize_exception": {
      "autonomy_state": "bounded_autonomous",
      "human_approval": "not_required"
    },
    "recommend_treatment": {
      "autonomy_state": "supervised",
      "human_approval": "required"
    },
    "clear_exception": {
      "autonomy_state": "revoked",
      "human_approval": "required"
    },
    "approve_payment": {
      "autonomy_state": "revoked",
      "human_approval": "required"
    }
  },
  "promotion": {
    "minimum_reviewed_cases": 100,
    "critical_error_limit": 0,
    "human_authorization_required": true
  },
  "rollback": {
    "missing_evidence": "demote_to_supervised",
    "critical_error": "revoke"
  }
