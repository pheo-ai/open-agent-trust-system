{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openagenttrustsystem.org/v1/skill-manifest.v1.json",
  "title": "Open Agent Trust System Skill Manifest",
  "type": "object",
  "required": ["schema", "skill_id", "version", "artifact", "publisher", "capabilities"],
  "properties": {
    "schema": {"const": "oats.skill/v1"},
    "skill_id": {"type": "string", "minLength": 3, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
    "version": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object",
      "required": ["uri", "digest"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256Digest"},
        "media_type": {"type": "string"},
        "license": {"type": "string"}
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "contact": {"type": "string"},
        "identity_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["action_classes"],
      "properties": {
        "action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/actionClass"}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "data_access": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "network": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "opensharing_agent_skill": {"type": "string"},
        "mcp_server": {"type": "string"},
        "profile_version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["active", "revoked", "yanked", "expired"]}
  },
  "additionalProperties": false,
  "$defs": {
    "actionClass": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z][a-zA-Z0-9_:-]*$"},
    "sha256Digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
