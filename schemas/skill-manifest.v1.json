{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openagenttrust.org/v1/skill-manifest.v1.json",
  "title": "Open Agent Trust Profile",
  "type": "object",
  "required": ["schema", "skill_id", "version", "artifact", "publisher", "capabilities"],
  "properties": {
    "schema": {"const": "oat.skill/v1"},
    "skill_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "required": ["uri", "digest"], "properties": {"uri": {"type": "string"}, "digest": {"type": "string"}, "license": {"type": "string"}}, "additionalProperties": false},
    "publisher": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "contact": {"type": "string"}}, "additionalProperties": false},
    "capabilities": {"type": "object", "required": ["action_classes"], "properties": {"action_classes": {"type": "array", "items": {"type": "string"}}, "tools": {"type": "array", "items": {"type": "string"}}, "data_access": {"type": "array", "items": {"type": "string"}}, "network": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "compatibility": {"type": "object"},
    "status": {"enum": ["active", "revoked", "yanked", "expired"]}
  },
  "additionalProperties": false
}
